{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run version:sync && ng build",
    "build:pages": "npm run version:sync && ng build --base-href ./",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "watch": "ng build --watch --configuration development",
